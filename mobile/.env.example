# Copy to .env (ignored by git). Both values are public by design: the database is protected by Row Level Security.
# NEVER put the service_role key or the database password here: everything EXPO_PUBLIC_* ends up inside the app.
EXPO_PUBLIC_SUPABASE_URL=https://citmdaphjkwrqtxzcvoh.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=<anon key from Supabase > Project Settings > API Keys>
# Google sign-in (Android): the *Web* OAuth client ID from Google Cloud. Leave empty to hide the button.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
